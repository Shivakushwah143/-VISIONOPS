{
  "title": "VisionOps application metrics",
  "uid": "visionops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(visionops_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(visionops_http_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Persisted safety/detection events",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (mode) (visionops_events_ingested_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Backend availability",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"visionops\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Camera input FPS",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_camera_input_fps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Camera inference FPS",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_camera_inference_fps",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Camera inference p95 ms",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_camera_inference_latency_ms{quantile=\"0.95\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Dropped frames",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_camera_dropped_frames",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reconnects",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_camera_reconnect_count",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Decoder queue",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_camera_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Device heartbeat age",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_device_heartbeat_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Campaign state",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "visionops_campaign_status",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Decode vs processed FPS",
      "description": "Absent when the device does not report the field; a gap is unknown, not zero.",
      "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8},
      "targets": [
        {"expr": "visionops_camera_decode_fps", "legendFormat": "decode {{camera_id}}", "refId": "A"},
        {"expr": "visionops_camera_processed_fps", "legendFormat": "processed {{camera_id}}", "refId": "B"}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Stream connectivity",
      "description": "1 = connected and fresh; a missing series means the device did not report it.",
      "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8},
      "targets": [
        {"expr": "visionops_camera_rtsp_connected", "refId": "A"}
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Stream age",
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"expr": "visionops_camera_stream_age_seconds", "refId": "A"}
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Observation window p95 latency (reported)",
      "description": "Only present when the device reports inference_latency_ms_p95. GPU families are absent by design when no GPU was measured.",
      "gridPos": {"x": 12, "y": 56, "w": 12, "h": 8},
      "targets": [
        {"expr": "visionops_camera_inference_latency_ms_p95", "refId": "A"}
      ]
    }
  ]
}