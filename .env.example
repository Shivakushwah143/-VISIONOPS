# VisionOps environment template (valid dotenv: KEY=VALUE and # comments only).
# Generate local values with scripts/setup.py. Never commit the resulting .env.
POSTGRES_PASSWORD=replace-with-generated-random-value
DATABASE_URL=postgresql+psycopg://visionops:replace-with-generated-random-value@postgres:5432/visionops
TOKEN_PEPPER=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8080
DATA_DIR=/data
MEDIA_ROOT=/media
TRUSTED_KEYS_DIR=/data/trusted_keys
MLFLOW_TRACKING_URI=http://mlflow:5000
GRAFANA_ADMIN_PASSWORD=replace-with-generated-random-value
ALLOW_PRIVATE_HTTP=0
# Console spans are opt-in and contain no captured headers or payloads.
OTEL_CONSOLE_ENABLED=0
# Video ingestion backend for edge workers: opencv | gstreamer | auto.
# gstreamer fails fast (IMPLEMENTED - NOT VERIFIED) when the bindings are absent.
VISIONOPS_VIDEO_BACKEND=opencv
# Local RTSP development stream (infrastructure/compose.rtsp.yaml + scripts/publish_rtsp).
VISIONOPS_RTSP_URL=rtsp://localhost:8554/live
# Optional simulated ARM64/Jetson target for control-plane exercises only.
# Declared versions are recorded as declared_not_measured and never as measured,
# and a simulated target refuses to report measured CUDA/TensorRT/JetPack values.
# VISIONOPS_DECLARED_ARCHITECTURE=aarch64
# VISIONOPS_DECLARED_JETPACK_VERSION=6.0
# VISIONOPS_DECLARED_CUDA_VERSION=12.2
# VISIONOPS_DECLARED_TENSORRT_VERSION=8.6
