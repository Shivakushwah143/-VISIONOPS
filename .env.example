# Generate values with scripts/setup.py. Never commit the resulting .env.
POSTGRES_PASSWORD=replace-with-generated-random-value
DATABASE_URL=postgresql+psycopg://visionops:replace-with-generated-random-value@postgres:5432/visionops
TOKEN_PEPPER=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8080
DATA_DIR=/data
MEDIA_ROOT=/media
TRUSTED_KEYS_DIR=/data/trusted_keys
MLFLOW_TRACKING_URI=http://mlflow:5000
GRAFANA_ADMIN_PASSWORD=replace-with-generated-random-value
ALLOW_PRIVATE_HTTP=0
# Console spans are opt-in and contain no captured headers or payloads.
OTEL_CONSOLE_ENABLED=0
